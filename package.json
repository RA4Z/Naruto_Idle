{
  "name": "naruto-idle-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test:server": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check:assets": "node tools/check-lfs.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "prettier": "^3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
