{
  "name": "naruto-idle-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:status": "node --use-system-ca tools/supabase-status.mjs",
    "db:verify": "node --use-system-ca tools/supabase-verify.mjs",
    "db:setup": "node --use-system-ca tools/supabase-setup.mjs",
    "check:bundle-secrets": "node tools/check-bundle-secrets.mjs",
    "test:cloud": "node --experimental-transform-types --import ./tools/resolve-test-imports.mjs --test --test-concurrency=1 tests/cloud-sync.test.ts tests/cloud-storage.test.ts tests/cloud-database.test.mjs tests/account-database.test.mjs tests/cloud-only-database.test.mjs tests/session-takeover.test.mjs tests/migration-history.test.mjs",
    "predev": "node tools/prepare-runtime.mjs",
    "preadmin": "node tools/prepare-runtime.mjs",
    "prebuild": "node tools/prepare-runtime.mjs",
    "dev": "vite --host 0.0.0.0 --port 5178 --strictPort --configLoader runner",
    "admin": "vite --host 0.0.0.0 --port 5178 --strictPort --open /admin --configLoader runner",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node tools/check-i18n.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test:server": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check:assets": "node tools/check-lfs.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.56.1",
    "prettier": "^3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
